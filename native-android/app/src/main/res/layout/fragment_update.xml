<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <LinearLayout
        android:layout_width="520dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@color/surface"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="28dp">

        <!-- Title -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="软件更新"
            android:textColor="@color/accent"
            android:textSize="22sp"
            android:textStyle="bold" />

        <!-- Current Version -->
        <TextView
            android:id="@+id/tv_current_version"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="当前版本：v1.0.0"
            android:textColor="@color/text_secondary"
            android:textSize="15sp" />

        <!-- Status Message -->
        <TextView
            android:id="@+id/tv_update_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:text="点击下方按钮检查最新版本"
            android:textColor="@color/text_primary"
            android:textSize="15sp" />

        <!-- Loading Spinner -->
        <ProgressBar
            android:id="@+id/progress_checking"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginTop="16dp"
            android:indeterminate="true"
            android:visibility="gone"
            tools:visibility="visible" />

        <!-- New Version Details Layout -->
        <LinearLayout
            android:id="@+id/layout_update_details"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="vertical"
            android:visibility="gone"
            tools:visibility="visible">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tv_latest_version"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="发现新版本：v2026.10.11"
                    android:textColor="@color/success_color"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_apk_size"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="大小：11.2 MB"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="更新内容："
                android:textColor="@color/text_secondary"
                android:textSize="13sp" />

            <ScrollView
                android:id="@+id/scroll_changelog"
                android:layout_width="match_parent"
                android:layout_height="120dp"
                android:layout_marginTop="6dp"
                android:background="@color/card_background"
                android:focusable="true"
                android:padding="10dp">

                <TextView
                    android:id="@+id/tv_changelog"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/text_primary"
                    android:textSize="13sp"
                    tools:text="1. 优化播放体验\n2. 修复若干已知问题" />
            </ScrollView>
        </LinearLayout>

        <!-- Download Progress Section -->
        <LinearLayout
            android:id="@+id/layout_download_progress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="vertical"
            android:visibility="gone"
            tools:visibility="visible">

            <ProgressBar
                android:id="@+id/progress_download"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="12dp"
                android:max="100"
                android:progress="0" />

            <TextView
                android:id="@+id/tv_download_progress"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="8dp"
                android:text="正在下载：0%"
                android:textColor="@color/text_secondary"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- Action Button -->
        <TextView
            android:id="@+id/btn_action"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="20dp"
            android:background="@drawable/menu_item_bg"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="检查更新"
            android:textColor="@color/text_primary"
            android:textSize="16sp" />

    </LinearLayout>

</FrameLayout>
