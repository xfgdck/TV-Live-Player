<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:keepScreenOn="true">

    <SurfaceView
        android:id="@+id/surface_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- 加载中 -->
    <ProgressBar
        android:id="@+id/progress_bar"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:layout_gravity="center"
        android:visibility="gone" />

    <!-- 错误提示 -->
    <LinearLayout
        android:id="@+id/error_layout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:gravity="center"
        android:visibility="gone">
        <TextView
            android:id="@+id/tv_error"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/error_tip"
            android:textColor="@color/error_color"
            android:textSize="20sp" />
        <Button
            android:id="@+id/btn_retry"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/retry"
            android:layout_marginTop="16dp" />
    </LinearLayout>

    <!-- 欢迎页面 -->
    <TextView
        android:id="@+id/tv_welcome"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:text="@string/welcome"
        android:textColor="@color/text_secondary"
        android:textSize="24sp"
        android:visibility="gone" />

    <!-- 顶部 OSD -->
    <LinearLayout
        android:id="@+id/osd_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:orientation="horizontal"
        android:background="#88000000"
        android:padding="16dp"
        android:visibility="gone">
        <TextView
            android:id="@+id/tv_channel_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@color/text_primary"
            android:textSize="22sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/tv_category"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/text_secondary"
            android:textSize="18sp" />
    </LinearLayout>

    <!-- 底部控制栏 -->
    <LinearLayout
        android:id="@+id/controls_layout"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_gravity="bottom"
        android:background="#AA000000"
        android:gravity="center"
        android:visibility="gone"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp">

        <ImageButton
            android:id="@+id/btn_channel_list"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@android:drawable/ic_menu_sort_by_size"
            android:background="?attr/actionBarItemBackground"
            android:contentDescription="@string/channel_list"
            android:tint="@color/text_primary" />

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <ImageButton
            android:id="@+id/btn_prev_channel"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@android:drawable/ic_media_previous"
            android:background="?attr/actionBarItemBackground"
            android:contentDescription="@string/prev_channel"
            android:tint="@color/text_primary" />

        <ImageButton
            android:id="@+id/btn_play_pause"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginHorizontal="24dp"
            android:src="@android:drawable/ic_media_pause"
            android:background="?attr/actionBarItemBackground"
            android:contentDescription="@string/play_pause"
            android:tint="@color/text_primary" />

        <ImageButton
            android:id="@+id/btn_next_channel"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@android:drawable/ic_media_next"
            android:background="?attr/actionBarItemBackground"
            android:contentDescription="@string/next_channel"
            android:tint="@color/text_primary" />

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <ImageButton
            android:id="@+id/btn_exit"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@android:drawable/ic_menu_close_clear_cancel"
            android:background="?attr/actionBarItemBackground"
            android:contentDescription="@string/exit"
            android:tint="@color/text_primary" />

    </LinearLayout>

    <!-- 左侧频道切块 -->
    <LinearLayout
        android:id="@+id/side_controls"
        android:layout_width="80dp"
        android:layout_height="match_parent"
        android:layout_gravity="end"
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:background="#44000000"
        android:visibility="gone">

        <ImageButton
            android:id="@+id/btn_side_up"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:src="@android:drawable/ic_media_previous"
            android:rotation="90"
            android:background="@null"
            android:contentDescription="@string/prev_channel"
            android:scaleType="center"
            android:tint="@color/text_primary" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/change_channel"
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            android:layout_marginVertical="8dp" />

        <ImageButton
            android:id="@+id/btn_side_down"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:src="@android:drawable/ic_media_next"
            android:rotation="90"
            android:background="@null"
            android:contentDescription="@string/next_channel"
            android:scaleType="center"
            android:tint="@color/text_primary" />

    </LinearLayout>

</FrameLayout>
